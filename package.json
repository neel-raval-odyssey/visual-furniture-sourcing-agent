{
  "name": "visual-furniture-sourcing-agent",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "start": "pnpm --filter web start",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "demo:pipeline": "pnpm --filter web demo:pipeline",
    "analyze:image": "pnpm --filter web analyze:image",
    "eval:images": "pnpm --filter web eval:images",
    "source:candidates": "pnpm --filter web source:candidates",
    "shortlist:images": "pnpm --filter web shortlist:images",
    "verify:visual": "pnpm --filter web verify:visual",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
