# Visual Furniture Sourcing Agent
# Copy the variables you need into apps/web/.env.local (git-ignored).
# Never commit real values. Do not prefix secrets with NEXT_PUBLIC_.

# OpenAI API credential (required for live image analysis)
OPENAI_API_KEY=

# Image-understanding model
OPENAI_IMAGE_UNDERSTANDING_MODEL=gpt-6-luna

# Detailed visual-verification model (optional; default gpt-6.1-sol)
OPENAI_VISUAL_VERIFICATION_MODEL=gpt-6.1-sol

# Automated marketplace discovery (Apify; third-party provider). Required only for discover:marketplace --live/--resume/--fetch-images
APIFY_TOKEN=
